# =============================================================================
# RetailSense AI — Environment Configuration Example
# Copy this file to .env and populate with your actual values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="RetailSense AI"
APP_VERSION="0.1.0"
APP_ENV="development"          # development | staging | production
DEBUG=true
LOG_LEVEL="INFO"               # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_V1_PREFIX="/api/v1"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/retailsense"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ---------------------------------------------------------------------------
# Security  (placeholder — authentication not yet implemented)
# ---------------------------------------------------------------------------
SECRET_KEY="changeme-use-a-long-random-string-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
